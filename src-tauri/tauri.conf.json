{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Ziran",
  "version": "0.3.4",
  "identifier": "com.ziran.app",
  "build": {
    "frontendDist": "./web/dist",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:43123",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Ziran",
        "width": 1280,
        "height": 820,
        "minWidth": 480,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
